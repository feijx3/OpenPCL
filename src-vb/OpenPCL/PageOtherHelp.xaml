<local:OurPageRight
	x:Class="PCL.PageOtherHelp"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="clr-namespace:PCL"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	PanScroll="PanBack">
	<Grid>
		<!--未知连接 ID: 1-->
		<local:OurScrollViewer
			x:Name="PanBack"
			Visibility="Collapsed"
			VerticalScrollBarVisibility="Auto"
			HorizontalScrollBarVisibility="Disabled">
			<!--未知连接 ID: 2-->
			<StackPanel
				x:Name="PanMain"
				Margin="25,25,25,10"
				Grid.IsSharedSizeScope="True">
				<!--未知连接 ID: 3-->
				<local:OurSearchBox
					x:Name="SearchBox"
					Margin="0,0,0,15"
					HintText="搜索帮助" />
				<Grid>
					<!--未知连接 ID: 4-->
					<local:OurCard
						x:Name="PanSearch"
						Visibility="Collapsed"
						VerticalAlignment="Top"
						Opacity="0"
						Margin="0,0,0,15"
						Title=" "
						MinHeight="40">
						<!--未知连接 ID: 5-->
						<StackPanel
							Name="PanSearchList"
							Margin="20,40,18,18"
							VerticalAlignment="Top" />
					</local:OurCard>
					<!--未知连接 ID: 6-->
					<StackPanel
						Name="PanList" />
				</Grid>
			</StackPanel>
		</local:OurScrollViewer>
		<!--未知连接 ID: 7-->
		<local:OurCard
			x:Name="PanLoad"
			Visibility="Collapsed"
			HorizontalAlignment="Center"
			VerticalAlignment="Center"
			Margin="40,0"
			SnapsToDevicePixels="True"
			UseAnimation="False">
			<!--未知连接 ID: 8-->
			<local:OurLoading
				x:Name="Load"
				Text="正在加载帮助列表"
				Margin="20,20,20,17"
				HorizontalAlignment="Center"
				VerticalAlignment="Center" />
		</local:OurCard>
	</Grid>
</local:OurPageRight>
