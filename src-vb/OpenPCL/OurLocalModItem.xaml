<Grid
	x:Class="PCL.OurLocalModItem"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="clr-namespace:PCL;assembly="
	x:Name="PanBack"
	Height="44"
	RenderTransformOrigin="0.5,0.5"
	Background="{StaticResource ColorBrushSemiTransparent}"
	SnapsToDevicePixels="True">
	<Grid.ColumnDefinitions>
		<ColumnDefinition
			Width="6" />
		<ColumnDefinition
			Width="34" />
		<ColumnDefinition
			Width="7" />
		<ColumnDefinition
			Width="Auto" />
		<ColumnDefinition
			Width="1*" />
		<!--未知连接 ID: 2-->
		<ColumnDefinition
			x:Name="ColumnPaddingRight"
			Width="4" />
	</Grid.ColumnDefinitions>
	<Grid.RowDefinitions>
		<RowDefinition
			Height="1*" />
		<RowDefinition
			Height="17" />
		<RowDefinition
			Height="18" />
		<RowDefinition
			Height="1*" />
	</Grid.RowDefinitions>
	<Border
		Grid.Column="1"
		Grid.Row="1"
		Grid.RowSpan="2"
		IsHitTestVisible="False"
		SnapsToDevicePixels="True"
		UseLayoutRounding="True"
		HorizontalAlignment="Right"
		VerticalAlignment="Center"
		Width="34"
		Height="34">
		<UIElement.Clip>
			<RectangleGeometry
				Rect="0,0,34,34"
				RadiusX="6"
				RadiusY="6" />
		</UIElement.Clip>
		<!--未知连接 ID: 3-->
		<local:OurImage
			x:Name="PathLogo"
			RenderOptions.BitmapScalingMode="HighQuality"
			FallbackSource="pack://application:,,,/images/Icons/NoIcon.png" />
	</Border>
	<!--未知连接 ID: 4-->
	<Grid
		x:Name="PanTitle"
		Column="3"
		ColumnSpan="2"
		Row="1"
		VerticalAlignment="Bottom"
		Margin="0,1,0,0"
		SnapsToDevicePixels="False"
		UseLayoutRounding="False">
		<Grid.ColumnDefinitions>
			<!--未知连接 ID: 5-->
			<ColumnDefinition
				x:Name="ColumnTitle"
				Width="Auto" />
			<!--未知连接 ID: 6-->
			<ColumnDefinition
				x:Name="ColumnSubtitle"
				Width="Auto" />
			<ColumnDefinition
				Width="Auto" />
			<!--未知连接 ID: 7-->
			<ColumnDefinition
				x:Name="ColumnExtend"
				Width="1*" />
		</Grid.ColumnDefinitions>
		<!--未知连接 ID: 8-->
		<TextBlock
			x:Name="LabTitle"
			TextTrimming="CharacterEllipsis"
			FontSize="14"
			IsHitTestVisible="False" />
		<!--未知连接 ID: 9-->
		<TextBlock
			x:Name="LabSubtitle"
			Grid.Column="1"
			HorizontalAlignment="Left"
			TextTrimming="CharacterEllipsis"
			FontSize="12"
			IsHitTestVisible="False"
			Foreground="{StaticResource ColorBrushGray1}"
			Opacity="0.4"
			VerticalAlignment="Bottom"
			Visibility="Collapsed" />
		<!--未知连接 ID: 10-->
		<local:OurIconButton
			x:Name="BtnUpdate"
			Grid.Column="2"
			Width="21"
			Height="21"
			Margin="-2,-1.6,0,0"
			Theme="Black"
			Opacity="0.4"
			Visibility="Collapsed"
			ToolTipService.InitialShowDelay="100"
			Logo="M640 768H384l-32-32V509H213L190 454l298-298h45l298 298L810 509h-138v226z m-224-64h192V477l32-32h93L512 223 290 445H384l32 32zM352 831h320v64h-320z" />
	</Grid>
	<!--未知连接 ID: 11-->
	<StackPanel
		x:Name="PanTags"
		Grid.Row="2"
		Grid.Column="3"
		Orientation="Horizontal"
		VerticalAlignment="Bottom"
		Margin="-1,0,1,0"
		Visibility="Collapsed"
		IsHitTestVisible="False" />
	<!--未知连接 ID: 12-->
	<TextBlock
		x:Name="LabInfo"
		Grid.Row="2"
		Grid.Column="4"
		VerticalAlignment="Bottom"
		Margin="0,0,3,1"
		TextTrimming="CharacterEllipsis"
		FontSize="12"
		Foreground="{StaticResource ColorBrushGray4}"
		IsHitTestVisible="False"
		SnapsToDevicePixels="False"
		UseLayoutRounding="False" />
</Grid>
