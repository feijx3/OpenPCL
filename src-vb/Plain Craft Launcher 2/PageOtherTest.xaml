<local:MyPageRight
	x:Class="PCL.PageOtherTest"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:PCL"
	xmlns:sys="clr-namespace:System;assembly=mscorlib"
	PanScroll="PanBack">
	<!--未知连接 ID: 1-->
	<local:MyScrollViewer
		x:Name="PanBack"
		VerticalScrollBarVisibility="Auto"
		HorizontalScrollBarVisibility="Disabled">
		<StackPanel
			Orientation="Vertical"
			Margin="25,25,25,10">
			<local:MyCard
				Title="百宝箱"
				Margin="0,0,0,15">
				<WrapPanel
					Orientation="Horizontal"
					Margin="25,42,6,10">
					<!--未知连接 ID: 2-->
					<local:MyButton
						x:Name="BtnJrrp"
						Text="今日人品"
						Height="35"
						Margin="0,0,15,12"
						Width="140" />
					<!--未知连接 ID: 3-->
					<local:MyButton
						x:Name="BtnMemory"
						Text="内存优化"
						Height="35"
						Margin="0,0,15,12"
						Width="140"
						ToolTip="将物理内存占用降低约 1/3，不仅限于 MC！&#xA;如果使用机械硬盘，这可能会导致一小段时间的严重卡顿。&#xA;使用 --memory 参数启动 PCL 可以静默执行内存优化。" />
					<!--未知连接 ID: 4-->
					<local:MyButton
						x:Name="BtnClear"
						Text="清理游戏垃圾"
						Height="35"
						Margin="0,0,15,12"
						Width="140"
						ToolTip="清理 PCL 的缓存与 MC 的日志、崩溃报告等垃圾文件" />
					<!--未知连接 ID: 5-->
					<local:MyButton
						x:Name="BtnClick"
						Text="千万别点"
						Height="35"
						Margin="0,0,15,12"
						Width="140"
						ColorType="Red" />
				</WrapPanel>
			</local:MyCard>
			<!--未知连接 ID: 6-->
			<local:MyCard
				x:Name="CardCave"
				Title="回声洞"
				Margin="0,0,0,15">
				<!--未知连接 ID: 7-->
				<TextBlock
					x:Name="LabCave"
					Margin="25,39,25,16"
					FontSize="13.5"
					IsHitTestVisible="False"
					Text="反复点击这里可以查看 PCL 作者与各位沙雕网友乱七八糟的留言！"
					TextWrapping="Wrap"
					Foreground="{DynamicResource ColorBrush1}" />
				<!--未知连接 ID: 8-->
				<local:MyTextButton
					x:Name="BtnCave"
					Margin="10,7"
					Padding="5"
					Text="投稿"
					VerticalAlignment="Top"
					HorizontalAlignment="Right" />
			</local:MyCard>
			<local:MyCard
				Title="下载自定义文件"
				Margin="0,0,0,15">
				<Grid
					Margin="25,38,25,21">
					<Grid.ColumnDefinitions>
						<ColumnDefinition
							Width="Auto"
							SharedSizeGroup="Name" />
						<ColumnDefinition
							Width="1*" />
						<ColumnDefinition
							Width="Auto" />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition
							Height="Auto" />
						<RowDefinition
							Height="Auto"
							MinHeight="28" />
						<RowDefinition
							Height="9" />
						<RowDefinition
							Height="Auto"
							MinHeight="28" />
						<RowDefinition
							Height="9" />
						<RowDefinition
							Height="Auto"
							MinHeight="28" />
						<RowDefinition
							Height="Auto" />
					</Grid.RowDefinitions>
					<TextBlock
						Margin="0,0,0,11"
						Text="使用 PCL 的高速多线程下载引擎下载任意文件。请注意，部分网站（例如百度网盘）可能会报错 (403) 已禁止，无法正常下载。"
						TextWrapping="Wrap"
						Grid.ColumnSpan="5" />
					<TextBlock
						Grid.Row="1"
						VerticalAlignment="Top"
						Margin="0,6,25,0"
						HorizontalAlignment="Left"
						Text="下载地址" />
					<!--未知连接 ID: 9-->
					<local:MyTextBox
						x:Name="TextDownloadUrl"
						Grid.Column="1"
						Grid.ColumnSpan="5"
						Grid.Row="1">
						<local:MyTextBox.ValidateRules>
							<local:ValidateExcept>
								<local:ValidateExcept.Excepts>
									<sys:String>ftp://</sys:String>
								</local:ValidateExcept.Excepts>
							</local:ValidateExcept>
							<local:ValidateHttp />
						</local:MyTextBox.ValidateRules>
					</local:MyTextBox>
					<TextBlock
						Grid.Row="3"
						VerticalAlignment="Top"
						HorizontalAlignment="Left"
						Text="保存到"
						Margin="0,6,25,0" />
					<!--未知连接 ID: 10-->
					<local:MyTextBox
						x:Name="TextDownloadFolder"
						Grid.Column="1"
						Grid.Row="3">
						<local:MyTextBox.ValidateRules>
							<local:ValidateFolderPath
								UseMinecraftCharCheck="False" />
						</local:MyTextBox.ValidateRules>
					</local:MyTextBox>
					<TextBlock
						Grid.Row="5"
						VerticalAlignment="Top"
						HorizontalAlignment="Left"
						Text="文件名"
						Margin="0,6,25,0" />
					<!--未知连接 ID: 11-->
					<local:MyTextBox
						x:Name="TextDownloadName"
						Grid.Column="1"
						Grid.ColumnSpan="5"
						Grid.Row="5">
						<local:MyTextBox.ValidateRules>
							<local:ValidateFileName
								UseMinecraftCharCheck="False"
								RequireParentFolderExists="False" />
						</local:MyTextBox.ValidateRules>
					</local:MyTextBox>
					<!--未知连接 ID: 12-->
					<local:MyTextButton
						x:Name="BtnDownloadSelect"
						Grid.Row="3"
						Grid.Column="2"
						Text="选择"
						VerticalAlignment="Top"
						Margin="6,2,0,1"
						Padding="4" />
					<WrapPanel
						Margin="-8,7,-8,0"
						Grid.Row="7"
						Grid.ColumnSpan="5"
						HorizontalAlignment="Center">
						<!--未知连接 ID: 13-->
						<local:MyButton
							x:Name="BtnDownloadStart"
							Margin="8,8,8,0"
							IsEnabled="False"
							Text="开始下载"
							Height="35"
							MinWidth="135"
							Padding="13,0"
							ColorType="Highlight" />
						<!--未知连接 ID: 14-->
						<local:MyButton
							x:Name="BtnDownloadOpen"
							Margin="8,8,8,0"
							IsEnabled="False"
							Text="打开文件夹"
							Height="35"
							MinWidth="135"
							Padding="13,0" />
					</WrapPanel>
				</Grid>
			</local:MyCard>
		</StackPanel>
	</local:MyScrollViewer>
</local:MyPageRight>
