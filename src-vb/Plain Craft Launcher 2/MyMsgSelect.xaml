<Grid
	x:Class="PCL.MyMsgSelect"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:my="clr-namespace:PCL"
	RenderTransformOrigin="0,0.5"
	UseLayoutRounding="True"
	SnapsToDevicePixels="True"
	MinWidth="400"
	HorizontalAlignment="Center"
	VerticalAlignment="Center"
	Margin="25">
	<UIElement.RenderTransform>
		<TransformGroup>
			<!--未知连接 ID: 1-->
			<RotateTransform
				x:Name="TransformRotate"
				Angle="-4" />
			<!--未知连接 ID: 2-->
			<TranslateTransform
				x:Name="TransformPos"
				X="0"
				Y="40" />
		</TransformGroup>
	</UIElement.RenderTransform>
	<!--未知连接 ID: 3-->
	<Border
		Name="PanBorder"
		CornerRadius="7"
		Background="#FBFBFB">
		<UIElement.Effect>
			<!--未知连接 ID: 4-->
			<DropShadowEffect
				Color="{DynamicResource ColorObject1}"
				BlurRadius="20"
				ShadowDepth="4"
				RenderingBias="Performance"
				Opacity="0.8"
				x:Name="EffectShadow" />
		</UIElement.Effect>
		<!--未知连接 ID: 5-->
		<Grid
			Name="PanMain"
			VerticalAlignment="Top"
			Margin="22,22,22,23">
			<Grid.RowDefinitions>
				<RowDefinition
					Height="Auto" />
				<RowDefinition
					Height="2" />
				<RowDefinition
					Height="13" />
				<RowDefinition
					Height="1*" />
				<RowDefinition
					Height="Auto" />
			</Grid.RowDefinitions>
			<!--未知连接 ID: 6-->
			<TextBlock
				Name="LabTitle"
				Grid.Row="0"
				FontSize="23"
				TextTrimming="None"
				Foreground="{DynamicResource ColorBrush2}"
				HorizontalAlignment="Left"
				Margin="7,-1,70,9"
				Text="测试标题文本"
				VerticalAlignment="Top"
				SnapsToDevicePixels="False"
				UseLayoutRounding="False" />
			<!--未知连接 ID: 7-->
			<Rectangle
				x:Name="ShapeLine"
				Grid.Row="1"
				Height="2"
				Fill="{Binding Foreground, ElementName=LabTitle}" />
			<!--未知连接 ID: 8-->
			<my:MyScrollViewer
				x:Name="PanCaption"
				Grid.Row="3"
				VerticalAlignment="Top"
				Margin="0,0,0,17"
				Padding="7,0,15,0"
				VerticalScrollBarVisibility="Auto"
				HorizontalScrollBarVisibility="Disabled"
				DeltaMult="0.7">
				<!--未知连接 ID: 9-->
				<StackPanel
					x:Name="PanSelection"
					Orientation="Vertical" />
			</my:MyScrollViewer>
			<!--未知连接 ID: 10-->
			<StackPanel
				Name="PanBtn"
				Grid.Row="4"
				VerticalAlignment="Top"
				HorizontalAlignment="Right"
				Margin="150,0,8,0"
				Orientation="Horizontal">
				<!--未知连接 ID: 11-->
				<my:MyButton
					x:Name="Btn1"
					ColorType="Normal"
					Text="测试按钮1"
					Margin="12,0,0,0"
					TextPadding="7"
					SnapsToDevicePixels="False"
					Padding="5,0"
					UseLayoutRounding="False" />
				<!--未知连接 ID: 12-->
				<my:MyButton
					x:Name="Btn2"
					ColorType="Normal"
					Text="测试按钮2"
					Margin="12,0,0,0"
					TextPadding="7"
					SnapsToDevicePixels="False"
					Padding="5,0"
					UseLayoutRounding="False" />
			</StackPanel>
		</Grid>
	</Border>
</Grid>
