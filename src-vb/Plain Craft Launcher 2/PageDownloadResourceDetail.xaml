<local:MyPageRight
	x:Class="PCL.PageDownloadResourceDetail"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="clr-namespace:PCL"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	PanScroll="PanBack">
	<!--未知连接 ID: 1-->
	<local:MyScrollViewer
		x:Name="PanBack"
		VerticalScrollBarVisibility="Auto"
		HorizontalScrollBarVisibility="Disabled">
		<Grid
			Margin="25,25,25,10">
			<Grid.RowDefinitions>
				<RowDefinition
					Height="Auto" />
				<RowDefinition
					Height="1*" />
			</Grid.RowDefinitions>
			<!--未知连接 ID: 2-->
			<local:MyCard
				x:Name="CardIntro"
				Margin="0,0,0,25">
				<!--未知连接 ID: 3-->
				<StackPanel
					x:Name="PanIntro"
					Margin="22,18,22,19">
					<StackPanel
						Orientation="Horizontal"
						Height="35">
						<!--未知连接 ID: 4-->
						<local:MyButton
							x:Name="BtnIntroWeb"
							MinWidth="140"
							Text="转到 CurseForge"
							Padding="13,0"
							Margin="0,0,20,0"
							HorizontalAlignment="Left"
							ColorType="Highlight" />
						<!--未知连接 ID: 5-->
						<local:MyButton
							x:Name="BtnIntroWiki"
							MinWidth="140"
							Text="转到 MC 百科"
							Padding="13,0"
							Margin="0,0,20,0"
							HorizontalAlignment="Left" />
						<!--未知连接 ID: 6-->
						<local:MyButton
							x:Name="BtnIntroCopy"
							MinWidth="140"
							Text="复制名称"
							Padding="13,0"
							Margin="0,0,20,0"
							HorizontalAlignment="Left" />
					</StackPanel>
				</StackPanel>
			</local:MyCard>
			<!--未知连接 ID: 7-->
			<StackPanel
				Name="PanMain"
				Grid.Row="1"
				Grid.RowSpan="2"
				Grid.IsSharedSizeScope="True">
				<!--未知连接 ID: 8-->
				<local:MyHint
					x:Name="HintAlternative"
					Theme="Blue"
					Margin="0,0,0,15" />
				<!--未知连接 ID: 9-->
				<local:MyCard
					x:Name="CardFilter"
					Margin="0,0,0,15">
					<!--未知连接 ID: 10-->
					<StackPanel
						x:Name="PanFilter"
						Margin="10,10,0,10"
						Orientation="Horizontal"
						VerticalAlignment="Top"
						HorizontalAlignment="Left" />
				</local:MyCard>
				<!--未知连接 ID: 11-->
				<StackPanel
					Name="PanResults" />
			</StackPanel>
			<!--未知连接 ID: 12-->
			<local:MyCard
				x:Name="PanLoad"
				Row="1"
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				SnapsToDevicePixels="True"
				UseAnimation="False"
				Margin="0,0,0,8">
				<!--未知连接 ID: 13-->
				<local:MyLoading
					x:Name="Load"
					Text="正在获取版本列表"
					Margin="20,20,20,17"
					HorizontalAlignment="Center"
					VerticalAlignment="Center" />
			</local:MyCard>
		</Grid>
	</local:MyScrollViewer>
</local:MyPageRight>
