<local:OurScrollViewer
	x:Class="PCL.PageResource"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:PCL"
	VerticalScrollBarVisibility="Auto"
	HorizontalScrollBarVisibility="Disabled">
	<StackPanel
		Orientation="Vertical"
		Margin="25">
		<!--未知连接 ID: 1-->
		<local:OurCard
			x:Name="PanAlways"
			Title="搜索XXX"
			Margin="0,0,0,15">
			<StackPanel
				Margin="25,40,25,15">
				<Grid
					Margin="0,0,0,11"
					HorizontalAlignment="Stretch">
					<Grid.ColumnDefinitions>
						<ColumnDefinition
							Width="Auto" />
						<ColumnDefinition
							Width="1.3*" />
						<ColumnDefinition
							Width="1.2*" />
						<ColumnDefinition
							Width="50" />
						<ColumnDefinition
							Width="Auto" />
						<ColumnDefinition
							Width="1*" />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition
							Height="28" />
						<RowDefinition
							Height="9" />
						<RowDefinition
							Height="28" />
					</Grid.RowDefinitions>
					<TextBlock
						VerticalAlignment="Center"
						HorizontalAlignment="Left"
						Text="名称"
						Margin="0,0,18,0" />
					<!--未知连接 ID: 2-->
					<local:OurTextBox
						x:Name="TextSearchName"
						Grid.Column="1"
						Grid.ColumnSpan="2" />
					<TextBlock
						VerticalAlignment="Center"
						Grid.Column="4"
						HorizontalAlignment="Left"
						Text="来源"
						Margin="0,0,18,0" />
					<!--未知连接 ID: 3-->
					<local:OurComboBox
						x:Name="ComboSearchSource"
						Grid.Column="5">
						<local:OurComboBoxItem
							Content="全部"
							Tag="3"
							IsSelected="True" />
						<local:OurComboBoxItem
							Content="CurseForge"
							Tag="1" />
						<local:OurComboBoxItem
							Content="Modrinth"
							Tag="2" />
					</local:OurComboBox>
					<TextBlock
						VerticalAlignment="Center"
						Grid.Row="2"
						HorizontalAlignment="Left"
						Text="版本"
						Margin="0,0,18,0" />
					<!--未知连接 ID: 4-->
					<local:OurComboBox
						x:Name="TextSearchVersion"
						Grid.Row="2"
						Grid.Column="1"
						Grid.ColumnSpan="2"
						IsEditable="True"
						IsTextSearchEnabled="False">
						<local:OurComboBoxItem
							Content="全部 (也可自行输入)"
							IsSelected="True" />
						<local:OurComboBoxItem
							Content="26.2" />
						<local:OurComboBoxItem
							Content="26.1" />
						<local:OurComboBoxItem
							Content="1.21.11" />
						<local:OurComboBoxItem
							Content="1.21.8" />
						<local:OurComboBoxItem
							Content="1.21.4" />
						<local:OurComboBoxItem
							Content="1.21.1" />
						<local:OurComboBoxItem
							Content="1.20.1" />
						<local:OurComboBoxItem
							Content="1.19.2" />
						<local:OurComboBoxItem
							Content="1.18.2" />
						<local:OurComboBoxItem
							Content="1.16.5" />
						<local:OurComboBoxItem
							Content="1.12.2" />
						<local:OurComboBoxItem
							Content="1.7.10" />
					</local:OurComboBox>
					<!--未知连接 ID: 5-->
					<local:OurComboBox
						x:Name="ComboSearchLoader"
						Visibility="Collapsed"
						Grid.Row="2"
						Grid.Column="2"
						Margin="10,0,0,0">
						<local:OurComboBoxItem
							Content="任意 Mod 加载器"
							IsSelected="True"
							Tag="0" />
						<local:OurComboBoxItem
							Content="Forge"
							Tag="1" />
						<local:OurComboBoxItem
							Content="NeoForge"
							Tag="16" />
						<local:OurComboBoxItem
							Content="Fabric"
							Tag="4" />
						<local:OurComboBoxItem
							Content="LiteLoader"
							Tag="2" />
					</local:OurComboBox>
					<TextBlock
						VerticalAlignment="Center"
						Grid.Column="4"
						Grid.Row="2"
						HorizontalAlignment="Left"
						Text="类型"
						Margin="0,0,18,0" />
					<!--未知连接 ID: 6-->
					<local:OurComboBox
						x:Name="ComboSearchTag"
						Grid.Column="5"
						Grid.Row="2" />
				</Grid>
				<Grid
					Margin="0,4,0,6"
					Height="35">
					<Grid.ColumnDefinitions>
						<ColumnDefinition
							Width="Auto"
							SharedSizeGroup="Button" />
						<ColumnDefinition
							Width="Auto"
							SharedSizeGroup="Button" />
						<ColumnDefinition
							Width="Auto"
							SharedSizeGroup="Button" />
					</Grid.ColumnDefinitions>
					<!--未知连接 ID: 7-->
					<local:OurButton
						x:Name="BtnSearchRun"
						Text="搜索"
						MinWidth="140"
						Padding="13,0"
						Margin="0,0,20,0"
						ColorType="Highlight" />
					<!--未知连接 ID: 8-->
					<local:OurButton
						x:Name="BtnSearchReset"
						Text="重置条件"
						MinWidth="140"
						Padding="13,0"
						Margin="0,0,20,0"
						Grid.Column="1" />
					<!--未知连接 ID: 9-->
					<local:OurButton
						x:Name="BtnSearchInstallModPack"
						Text="安装已有整合包"
						MinWidth="140"
						Padding="13,0"
						Margin="0,0,20,0"
						Grid.Column="2"
						ToolTip="在当前选择的 Minecraft 文件夹下安装整合包" />
				</Grid>
			</StackPanel>
		</local:OurCard>
		<!--未知连接 ID: 10-->
		<StackPanel
			x:Name="PanContent">
			<!--未知连接 ID: 11-->
			<local:OurHint
				x:Name="HintError"
				HasBorder="True"
				Text="无法连接到 Modrinth，所以目前仅显示了来自 CurseForge 的内容，搜索结果可能不全。&#xA;请稍后再试，或使用 VPN 改善网络环境。"
				Theme="Yellow"
				Margin="0,0,0,15" />
			<!--未知连接 ID: 12-->
			<local:OurCard
				x:Name="CardProjects"
				UseAnimation="False">
				<!--未知连接 ID: 13-->
				<StackPanel
					x:Name="PanProjects"
					Margin="12" />
			</local:OurCard>
			<!--未知连接 ID: 14-->
			<local:OurCard
				x:Name="CardPages"
				Margin="0,15,0,0"
				HorizontalAlignment="Center">
				<StackPanel
					Orientation="Horizontal"
					Height="23"
					Margin="10,7">
					<!--未知连接 ID: 15-->
					<local:OurIconButton
						x:Name="BtnPageFirst"
						IsEnabled="False"
						Opacity="0.2"
						Margin="0,0.5,5,0.5"
						Logo="M496.213333 329.856L315.306667 510.848l180.992 181.077333a42.666667 42.666667 0 1 1-60.330667 60.330667l-211.2-211.2a42.453333 42.453333 0 0 1-11.818667-22.613333l-0.597333-5.034667v-5.034667a42.496 42.496 0 0 1 12.373333-27.648l211.2-211.2a42.666667 42.666667 0 0 1 60.373334 60.330667z m298.666667 0l-180.949333 180.992 180.992 181.077333a42.666667 42.666667 0 1 1-60.330667 60.330667l-211.2-211.2a42.453333 42.453333 0 0 1-11.818667-22.613333l-0.597333-5.034667v-5.034667a42.496 42.496 0 0 1 12.373333-27.648l211.2-211.2a42.666667 42.666667 0 0 1 60.373334 60.330667z" />
					<!--未知连接 ID: 16-->
					<local:OurIconButton
						x:Name="BtnPageLeft"
						IsEnabled="False"
						Opacity="0.2"
						Margin="0,0,5,0"
						Logo="M650.752 278.357333l-241.322667 241.365334 241.322667 241.365333a42.666667 42.666667 0 1 1-60.330667 60.330667l-271.530666-271.530667a42.453333 42.453333 0 0 1-11.818667-22.613333l-0.597333-5.034667v-5.034667a42.496 42.496 0 0 1 12.416-27.648l271.530666-271.530666a42.666667 42.666667 0 0 1 60.330667 60.330666z" />
					<!--未知连接 ID: 17-->
					<TextBlock
						x:Name="LabPage"
						Text="1"
						Margin="8,0,13,0"
						FontSize="15"
						VerticalAlignment="Center"
						Foreground="{DynamicResource ColorBrush3}" />
					<!--未知连接 ID: 18-->
					<local:OurIconButton
						x:Name="BtnPageRight"
						Margin="0,0,30,0"
						Logo="M404.309333 278.357333l241.322667 241.365334-241.322667 241.365333a42.666667 42.666667 0 1 0 60.330667 60.330667l271.530667-271.530667a42.453333 42.453333 0 0 0 11.818666-22.613333l0.597334-5.034667v-5.034667a42.496 42.496 0 0 0-12.416-27.648L464.64 218.026667a42.666667 42.666667 0 0 0-60.330667 60.330666z" />
				</StackPanel>
			</local:OurCard>
		</StackPanel>
		<!--未知连接 ID: 19-->
		<local:OurCard
			x:Name="PanLoad"
			HorizontalAlignment="Center"
			VerticalAlignment="Center"
			SnapsToDevicePixels="True"
			UseAnimation="False"
			Margin="40,50">
			<!--未知连接 ID: 20-->
			<local:OurLoading
				x:Name="Load"
				Text="正在获取XXX列表"
				Margin="20,20,20,17"
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				ShowProgress="True" />
		</local:OurCard>
	</StackPanel>
</local:OurScrollViewer>
